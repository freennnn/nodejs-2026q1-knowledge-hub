PORT=4000
LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

IMAGE_LOCAL_NAME=knowledge-hub:local
IMAGE_HUB_NAME=freennnn/knowledge-hub:latest

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=60000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# local app + docker db: used by local Node processes etc. npm run start:dev
# Docker Compose overrides DATABASE_URL for containers to use the 'db' service hostname instead of 'localhost'
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public
# interpolation isn't safely parsed accross .env and dotenv - so we use manual string instead
#DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
# Embeddings model for RAG index + search query vectors
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Keep this aligned with Qdrant collection vector size (common values: 768, 1536, 3072)
GEMINI_EMBEDDING_DIMENSION=768

# Vector DB (Qdrant REST). Compose app service overrides to http://vectordb:6333 automatically.
RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://localhost:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles

# Chunking (sentence packing uses Intl.Segmenter + these limits)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CHUNK_LOCALE=en

# RAG chat: max stored messages per conversation (including user + assistant)
RAG_CONVERSATION_MAX_MESSAGES=20

AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300
